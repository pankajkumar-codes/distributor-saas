; Module boundaries for the single app (LLD-0 §7, D-027). Run from the repo root:
;   PYTHONPATH=app/src:libs/platform_common:migrator lint-imports
; LLD-0's rule is that a module imports other modules only through their
; `interface` package, and any module may import app.modules.refdata. Each allowed
; interface import is listed under ignore_imports below; everything else between
; modules is refused.

[importlinter]
root_packages =
    app
    platform_common
    migrator
include_external_packages = False

[importlinter:contract:modules-independent]
name = Modules do not import each other
type = independence
modules =
    app.modules.identity
    app.modules.business
    app.modules.catalog
    app.modules.imports
; identity creates the profile with a new business and shows business cards (LLD-1 §9).
ignore_imports =
    app.modules.identity.** -> app.modules.business.interface
; catalog checks customer GSTINs and HSN digits through business (LLD-3 §8.3).
    app.modules.catalog.** -> app.modules.business.interface
; Module tests drive the mounted app and may call other modules' interfaces, the
; same surface any module may use.
    app.modules.*.tests.** -> app.api
    app.modules.*.tests.** -> app.modules.*.interface

[importlinter:contract:refdata-leaf]
name = refdata imports no other module (every module may import refdata, LLD-0 §2)
type = forbidden
source_modules =
    app.modules.refdata
forbidden_modules =
    app.modules.identity
    app.modules.business
    app.modules.catalog
    app.modules.imports

[importlinter:contract:modules-not-entrypoints]
name = Modules do not import the API or worker entry points
type = forbidden
source_modules =
    app.modules
forbidden_modules =
    app.api
    app.worker
; Module tests drive the mounted app, so they may.
ignore_imports =
    app.modules.*.tests.** -> app.api

; Home composes modules through their interfaces only (LLD-1 L1-16).
[importlinter:contract:home-uses-interfaces]
name = app.home imports modules only through their interface packages
type = forbidden
source_modules =
    app.home
forbidden_modules =
    app.modules.identity
    app.modules.business
    app.modules.imports
    app.api
    app.worker
allow_indirect_imports = True
ignore_imports =
    app.home.** -> app.modules.*.interface

[importlinter:contract:home-is-a-leaf]
name = No module imports app.home
type = forbidden
source_modules =
    app.modules
forbidden_modules =
    app.home
; Module tests drive the mounted app, which mounts Home.
ignore_imports =
    app.modules.*.tests.** -> app.api

[importlinter:contract:platform-common-standalone]
name = platform_common imports nothing from the app or the migrator
type = forbidden
source_modules =
    platform_common
forbidden_modules =
    app
    migrator

[importlinter:contract:migrator-standalone]
name = The migrator imports nothing from the app or platform_common
type = forbidden
source_modules =
    migrator
forbidden_modules =
    app
    platform_common
